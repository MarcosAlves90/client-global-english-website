--- /dev/null
+++ b/tests/components/auth-provider-lazy-init.test.tsx
@@ -0,0 +1,71 @@
+import { cleanup, render, waitFor } from "@testing-library/react"
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"
+
+const authMocks = vi.hoisted(() => ({
+  auth: { currentUser: null },
+  hasFirebaseConfig: true,
+  onAuthStateChanged: vi.fn((_auth: unknown, listener: (user: null) => void) => {
+    queueMicrotask(() => listener(null))
+    return vi.fn()
+  }),
+  fetchUserProfile: vi.fn(),
+  signOutUser: vi.fn(),
+}))
+
+vi.mock("firebase/auth", () => ({
+  onAuthStateChanged: authMocks.onAuthStateChanged,
+}))
+
+vi.mock("@/lib/firebase/client", () => ({
+  auth: authMocks.auth,
+  hasFirebaseConfig: authMocks.hasFirebaseConfig,
+}))
+
+vi.mock("@/lib/firebase/firestore", () => ({
+  fetchUserProfile: authMocks.fetchUserProfile,
+}))
+
+vi.mock("@/lib/firebase/auth", () => ({
+  signOutUser: authMocks.signOutUser,
+}))
+
+import { AuthProvider } from "@/components/auth/auth-provider"
+import { useAuth } from "@/hooks/use-auth"
+
+afterEach(cleanup)
+
+beforeEach(() => {
+  authMocks.onAuthStateChanged.mockClear()
+  authMocks.fetchUserProfile.mockClear()
+  authMocks.signOutUser.mockClear()
+})
+
+function AuthConsumer() {
+  useAuth()
+  return null
+}
+
+describe("lazy auth initialization", () => {
+  it("does not initialize Firebase until an auth consumer requires it", () => {
+    render(
+      <AuthProvider>
+        <div>Public content</div>
+      </AuthProvider>
+    )
+
+    expect(authMocks.onAuthStateChanged).not.toHaveBeenCalled()
+    expect(authMocks.fetchUserProfile).not.toHaveBeenCalled()
+  })
+
+  it("initializes Firebase when an auth consumer requires it", async () => {
+    render(
+      <AuthProvider>
+        <AuthConsumer />
+      </AuthProvider>
+    )
+
+    await waitFor(() => {
+      expect(authMocks.onAuthStateChanged).toHaveBeenCalledTimes(1)
+    })
+  })
+})
diff --git a/tests/lib/firestore-parallel-fetch.test.ts b/tests/lib/firestore-parallel-fetch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ff2260c25d75b722d3ff883da2f84ff956c21f53
--- /dev/null
+++ b/tests/lib/firestore-parallel-fetch.test.ts
@@ -0,0 +1,135 @@
+import { beforeEach, describe, expect, it, vi } from "vitest"
+
+const firestoreMocks = vi.hoisted(() => ({
+  getDocs: vi.fn(),
+  collection: vi.fn((_database: unknown, name: string) => ({ name })),
+  doc: vi.fn(),
+  documentId: vi.fn(),
+  getCountFromServer: vi.fn(),
+  getDoc: vi.fn(),
+  query: vi.fn((reference: { name: string }, ...filters: Array<{ field: string; operator: string; value: unknown }>) => ({
+    collection: reference.name,
+    filters,
+  })),
+  serverTimestamp: vi.fn(),
+  setDoc: vi.fn(),
+  where: vi.fn((field: string, operator: string, value: unknown) => ({ field, operator, value })),
+}))
+
+vi.mock("firebase/firestore", () => firestoreMocks)
+
+vi.mock("@/lib/firebase/client", () => ({
+  db: {},
+  hasFirebaseConfig: true,
+}))
+
+vi.mock("@/lib/firebase/collections", () => ({
+  COLLECTIONS: {
+    enrollments: "enrollments",
+    tracks: "tracks",
+    materials: "materials",
+    activities: "activities",
+    users: "users",
+    courses: "courses",
+    activityProgress: "activityProgress",
+  },
+}))
+
+import { fetchUserActivities, fetchUserMaterials } from "@/lib/firebase/firestore"
+
+type Deferred<T> = {
+  promise: Promise<T>
+  resolve: (value: T) => void
+}
+
+function deferred<T>(): Deferred<T> {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((resolvePromise) => {
+    resolve = resolvePromise
+  })
+  return { promise, resolve }
+}
+
+function snapshot(entries: Array<[string, Record<string, unknown>]>) {
+  return {
+    docs: entries.map(([id, data]) => ({ id, data: () => data })),
+  }
+}
+
+const trackSnapshot = snapshot([
+  ["track-1", { courseId: "course-1", title: "Track", description: "", order: 0, userIds: [] }],
+])
+
+const contentSnapshots = {
+  materials: snapshot([
+    ["material-1", { courseId: "course-1", trackId: "track-1", title: "Reference", type: "pdf", visibility: "module", userIds: [], attachments: [] }],
+  ]),
+  activities: snapshot([
+    ["activity-1", { courseId: "course-1", trackId: "track-1", title: "Practice", type: "lesson", order: 1, estimatedMinutes: 10, visibility: "module", userIds: [], attachments: [], questions: [] }],
+  ]),
+}
+
+describe("student Firestore loaders", () => {
+  beforeEach(() => {
+    firestoreMocks.getDocs.mockReset()
+  })
+
+  it.each([
+    { label: "materials", collection: "materials", load: fetchUserMaterials },
+    { label: "activities", collection: "activities", load: fetchUserActivities },
+  ])("starts track and content reads in parallel after enrollment for $label", async ({ collection, load }) => {
+    const pendingTrackPublicRead = deferred<ReturnType<typeof snapshot>>()
+    const pendingTrackAssignedRead = deferred<ReturnType<typeof snapshot>>()
+    const pendingContentPublicRead = deferred<ReturnType<typeof snapshot>>()
+    const pendingContentAssignedRead = deferred<ReturnType<typeof snapshot>>()
+    const startedQueries: string[] = []
+
+    firestoreMocks.getDocs.mockImplementation(async (reference: { collection: string; filters: Array<{ field: string; operator: string; value: unknown }> }) => {
+      if (reference.collection === "enrollments") {
+        return snapshot([["enrollment-1", { courseId: "course-1", userId: "student-1", status: "active", progress: 0 }]])
+      }
+
+      const visibility = reference.filters.find((filter) => filter.field === "visibility")?.value
+      const assignment = reference.filters.find((filter) => filter.field === "userIds")
+      startedQueries.push(`${reference.collection}:${visibility ?? "tracks"}:${assignment?.operator ?? "public"}`)
+
+      if (reference.collection === "tracks" && assignment?.operator === "==") {
+        return pendingTrackPublicRead.promise
+      }
+
+      if (reference.collection === "tracks" && assignment?.operator === "array-contains") {
+        return pendingTrackAssignedRead.promise
+      }
+
+      if (reference.collection === collection && visibility === "module") {
+        return pendingContentPublicRead.promise
+      }
+
+      if (reference.collection === collection && visibility === "users") {
+        return pendingContentAssignedRead.promise
+      }
+
+      return snapshot([])
+    })
+
+    const resultPromise = load("student-1")
+
+    try {
+      await vi.waitFor(() => expect(startedQueries).toHaveLength(4))
+
+      pendingTrackPublicRead.resolve(trackSnapshot)
+      pendingTrackAssignedRead.resolve(snapshot([]))
+      pendingContentPublicRead.resolve(contentSnapshots[collection as keyof typeof contentSnapshots])
+      pendingContentAssignedRead.resolve(snapshot([]))
+
+      const results = await resultPromise
+      expect(results).toHaveLength(1)
+    } finally {
+      pendingTrackPublicRead.resolve(snapshot([]))
+      pendingTrackAssignedRead.resolve(snapshot([]))
+      pendingContentPublicRead.resolve(snapshot([]))
+      pendingContentAssignedRead.resolve(snapshot([]))
+      await resultPromise.catch(() => undefined)
+    }
+  })
+})
